# Base URL used for absolute URLs in metadata / Open Graph / sitemap.
NEXT_PUBLIC_SITE_URL=https://abhijeetmaske.dev

# Supabase — used by the Contact form to save submissions to the
# contact_messages table. See supabase/contact_messages.sql for the table
# + Row Level Security setup, and README.md for where to get these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TODO: Contact form backend (legacy notes, superseded by Supabase above).
# The contact form now writes directly to Supabase. These are left here
# only as alternative options if you ever want to swap providers:
#
# Option A — Formspree (no server code needed):
#   NEXT_PUBLIC_FORMSPREE_ENDPOINT=
#
# Option B — Resend (requires a small API route, e.g. src/app/api/contact/route.ts):
#   RESEND_API_KEY=

